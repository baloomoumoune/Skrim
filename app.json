{
  "expo": {
    "name": "Scrim",
    "slug": "scrim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "skrim",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.scrim.app",
      "associatedDomains": [
        "applinks:nlmtbflnzykjuwqigctt.supabase.co"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Scrim to access your photos to set your profile picture.",
        "NSCameraUsageDescription": "Allow Scrim to use the camera to scan QR codes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.scrim.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Scrim to access your photos to set your profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Scrim to use the camera to scan QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF4655"
        }
      ],
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f746bc4-9380-489b-bfab-54f4a0c5c984"
      }
    },
    "owner": "aymendevs-organization"
  }
}
